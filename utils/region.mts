export interface LoginCandidate {
	dataCenter: DataCenter;
	host: string;
	callingCode: string;
}

/** The data centers to try for a country, its own first, each with the calling code to log in with. */
export function loginCandidates(country: string | undefined): LoginCandidate[] {
	const routing = country ? countryRouting[country.toUpperCase()] : undefined;
	const first = routing?.[1] ?? 'eu';
	return [first, ...probeOrder.filter(dataCenter => dataCenter !== first)].map(dataCenter => ({
		dataCenter,
		host: dataCenterHosts[dataCenter],
		callingCode: routing && routing[1] === dataCenter ? routing[0] : fallbackCallingCodes[dataCenter],
	}));
}

/**
 * Whether a login error means the account lives in another data center. Password and code failures never do: those
 * come from the data center that owns the account, and retrying them elsewhere only burns failed-login attempts.
 */
export function isWrongDataCenter(code: string): boolean {
	const upper = code.toUpperCase();
	if (upper.includes('PASSWD') || upper.includes('MFA') || upper.includes('CODE')) return false;
	return upper.includes('NOT_EXIST') || upper.includes('SESSION') || upper.includes('REGION');
}

/** Reduces a host Tuya reports (bare, or as a full URL) to a bare host name, or undefined when there is none. */
export function normalizeHost(value: unknown): string | undefined {
	if (typeof value !== 'string') return undefined;
	const host = value
		.trim()
		.replace(/^https?:\/\//, '')
		.split('/')[0]
		.trim();
	return host || undefined;
}
