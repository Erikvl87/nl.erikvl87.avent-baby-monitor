    "triggers": [
      {
        "id": "alarm_crying_true",
        "title": {
          "en": "Baby started crying",
          "nl": "Baby begon te huilen"
        },
        "hint": {
          "en": "SenseIQ heard the baby cry.",
          "nl": "SenseIQ hoorde de baby huilen."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=baby-monitor&capabilities=alarm_crying"
          }
        ]
      },
      {
        "id": "alarm_crying_false",
        "title": {
          "en": "Baby stopped crying",
          "nl": "Baby stopte met huilen"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=baby-monitor&capabilities=alarm_crying"
          }
        ]
      },
      {
