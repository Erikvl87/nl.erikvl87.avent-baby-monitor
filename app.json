            "type": "device",
            "name": "device",
            "filter": "driver_id=baby-monitor"
          }
        ]
      },
      {
        "id": "went-offline",
        "title": {
          "en": "Monitor went offline",
          "nl": "Babyfoon ging offline"
        },
        "hint": {
          "en": "Runs when the monitor loses its connection, for example when it is unplugged or out of Wi-Fi range. Based on what the Philips Avent cloud reports, so it can take a few minutes.",
          "nl": "Wordt uitgevoerd als de babyfoon zijn verbinding verliest, bijvoorbeeld als de stekker eruit is of de wifi buiten bereik is. Gebaseerd op wat de Philips Avent-cloud meldt, dus het kan een paar minuten duren."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=baby-monitor"
          }
        ]
      },
