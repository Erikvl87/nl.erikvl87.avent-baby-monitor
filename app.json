        "title": {
          "en": "Breathing rate changed",
          "nl": "Ademhaling veranderd"
        },
        "hint": {
          "en": "SenseIQ reports the breathing rate while the baby is in the crib.",
          "nl": "SenseIQ meldt de ademhaling zolang de baby in het bedje ligt."
        },
        "tokens": [
          {
            "name": "measure_breathing_rate",
            "type": "number",
            "title": {
              "en": "Breaths per minute",
              "nl": "Ademhalingen per minuut"
            },
            "example": 32
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=baby-monitor&capabilities=alarm_crying"
          }
        ]
      },
      {
        "id": "privacy_mode_true",
        "title": {
          "en": "Privacy mode turned on",
          "nl": "Privacymodus aangezet"
        },
        "hint": {
          "en": "The camera was turned off.",
          "nl": "De camera is uitgezet."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=baby-monitor"
          }
        ]
      },
      {
        "id": "privacy_mode_false",
        "title": {
          "en": "Privacy mode turned off",
          "nl": "Privacymodus uitgezet"
        },
        "hint": {
          "en": "The camera was turned on.",
          "nl": "De camera is aangezet."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=baby-monitor"
          }
        ]
      },
      {
        "id": "lullaby-changed",
        "title": {
          "en": "Lullaby changed",
          "nl": "Slaapliedje veranderd"
        },
        "hint": {
          "en": "Runs when a different sound is selected, from Homey or on the monitor.",
          "nl": "Wordt uitgevoerd als er een ander geluid gekozen is, vanuit Homey of op de babyfoon."
        },
        "tokens": [
          {
            "name": "name",
            "type": "string",
            "title": {
              "en": "Lullaby",
              "nl": "Slaapliedje"
            },
            "example": {
              "en": "White Noise",
              "nl": "Witte ruis"
            }
          },
          {
            "name": "id",
            "type": "string",
